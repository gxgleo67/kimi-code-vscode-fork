{
  "name": "kimicode-vscode-fork",
  "publisher": "gxgleo",
  "displayName": "Kimi Code (Fork)",
  "description": "Official Kimi Code plugin for VS Code",
  "version": "0.8.8",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gxgleo67/kimi-code-vscode-fork.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "assistant",
    "code",
    "chat",
    "agent",
    "mcp",
    "skills",
    "json",
    "autocomplete",
    "moonshot",
    "kimi",
    "moonshot-ai"
  ],
  "pricing": "Free",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "icon": "resources/kimi-icon-storefront.png",
  "contributes": {
    "configuration": {
      "title": "Kimi Fork",
      "properties": {
        "kimifork.yoloMode": {
          "type": "boolean",
          "default": false,
          "description": "Legacy fallback only: seeds the permission mode of old sessions that predate per-session modes. New sessions always start in Manual; use the permission picker in the composer instead."
        },
        "kimifork.autosave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save files before Kimi reads or writes them"
        },
        "kimifork.enableNewConversationShortcut": {
          "type": "boolean",
          "default": false,
          "description": "Use Cmd/Ctrl+N to start a new conversation when Kimi is focused"
        },
        "kimifork.useCtrlEnterToSend": {
          "type": "boolean",
          "default": false,
          "description": "Use Ctrl/Cmd+Enter to send prompts instead of Enter"
        },
        "kimifork.showThinkingContent": {
          "type": "boolean",
          "default": true,
          "description": "Show thinking/reasoning content in the chat UI"
        },
        "kimifork.showThinkingExpanded": {
          "type": "boolean",
          "default": false,
          "description": "Auto-expand thinking/reasoning sections when shown (requires 'Show Thinking Content' to be enabled)"
        },
        "kimifork.editorContext": {
          "type": "string",
          "default": "never",
          "enum": [
            "never",
            "onConversationStart",
            "onFileChange"
          ],
          "enumDescriptions": [
            "Never share editor context",
            "Share once when conversation starts",
            "Share when active file changes"
          ],
          "description": "Control when to share the active editor's file and cursor position with Kimi"
        },
        "kimifork.defaultThinkingEffort": {
          "type": "string",
          "default": "high",
          "enum": [
            "off",
            "low",
            "medium",
            "high"
          ],
          "description": "Default thinking effort for new conversations (falls back to the model's default when unsupported) / 新对话的默认思考强度(模型不支持时回落模型默认)"
        },
        "kimifork.language": {
          "type": "string",
          "default": "en",
          "enum": [
            "en",
            "zh"
          ],
          "description": "UI language / 界面语言"
        },
        "kimifork.autoCompactContext": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run /compact when a turn ends with the context above 256K tokens, preventing context overflow on 256K-context models (e.g. K3-256k). Default off. / 任务结束后上下文超过 256K 时自动执行 /compact，防止 256K 上下文模型（如 K3-256k）超限丢失上下文，默认关闭"
        },
        "kimifork.compactComposer": {
          "type": "boolean",
          "default": false,
          "description": "Show the composer's permission/mode buttons in compact icon form to save space in narrow sidebars; the model name and thinking effort always stay fully visible. Default off. / 输入框的权限/模式按钮以图标形式精简显示，节省窄侧栏空间；模型名称与思考强度始终完整显示，默认关闭"
        },
        "kimifork.useAgentCoreV1": {
          "type": "boolean",
          "default": false,
          "description": "Temporary rollback switch: run Kimi on the legacy v1 engine instead of the current one. This setting will be removed in a future version. Requires a window reload to take effect."
        }
      }
    },
    "commands": [
      {
        "command": "kimifork.clearAllState",
        "title": "Kimi Fork: [DEBUG] Clear All State"
      },
      {
        "command": "kimifork.openInTab",
        "title": "Kimi Fork: Open in New Tab",
        "icon": "$(link-external)"
      },
      {
        "command": "kimifork.openInSideBar",
        "title": "Kimi Fork: Open in Side Panel",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "kimifork.focusInput",
        "title": "Kimi Fork: Focus Input",
        "icon": "$(edit)"
      },
      {
        "command": "kimifork.insertMention",
        "title": "Kimi Fork: Insert Current File",
        "icon": "$(mention)"
      },
      {
        "command": "kimifork.newConversation",
        "title": "Kimi Fork: New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "kimifork.showLogs",
        "title": "Kimi Fork: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "kimifork.resetKimi",
        "title": "Kimi Fork: Reset Kimi (in case of any issues/no response)",
        "icon": "$(refresh)"
      },
      {
        "command": "kimifork.logout",
        "title": "Kimi Fork: Logout",
        "icon": "$(sign-out)"
      },
      {
        "command": "kimifork.migrateLegacyData",
        "title": "Kimi Fork: Migrate Legacy Data"
      }
    ],
    "keybindings": [
      {
        "command": "kimifork.focusInput",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      },
      {
        "command": "kimifork.insertMention",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kimifork-sidebar",
          "title": "Kimi Fork",
          "icon": "resources/kimi-icon.svg"
        }
      ]
    },
    "views": {
      "kimifork-sidebar": [
        {
          "type": "webview",
          "id": "kimifork.webview",
          "name": "Kimi Code"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kimifork.openInTab",
          "when": "view == kimifork.webview",
          "group": "navigation"
        },
        {
          "command": "kimifork.newConversation",
          "when": "view == kimifork.webview",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "kimifork.clearAllState",
          "when": "isDevelopment"
        },
        {
          "command": "kimifork.openInTab",
          "when": "true"
        },
        {
          "command": "kimifork.openInSideBar",
          "when": "true"
        },
        {
          "command": "kimifork.focusInput",
          "when": "true"
        },
        {
          "command": "kimifork.insertMention",
          "when": "true"
        },
        {
          "command": "kimifork.newConversation",
          "when": "true"
        },
        {
          "command": "kimifork.showLogs",
          "when": "true"
        },
        {
          "command": "kimifork.resetKimi",
          "when": "true"
        },
        {
          "command": "kimifork.logout",
          "when": "kimifork.isLoggedIn"
        },
        {
          "command": "kimifork.migrateLegacyData",
          "when": "true"
        }
      ],
      "editor/context": [
        {
          "command": "kimifork.insertMention",
          "group": "moonshot-ai",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "dev": "pnpm run dev:prepare && pnpm run \"/^dev:(extension|webview)$/\"",
    "dev:prepare": "node scripts/prepare-dev.mjs",
    "dev:extension": "node scripts/watch-extension.mjs",
    "dev:webview": "vite build --config webview-ui/vite.config.ts --watch --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview-ui/tsconfig.json --noEmit",
    "build": "pnpm run build:extension && pnpm run build:webview",
    "build:webview": "vite build --config webview-ui/vite.config.ts",
    "build:extension": "tsdown --config tsdown.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:extension-host": "node scripts/extension-host-smoke.mjs",
    "package:platform": "node scripts/vsix-package.mjs",
    "package:verify": "node scripts/vsix-verify.mjs",
    "publish:vsix": "node scripts/vsix-publish.mjs",
    "publish:ovsx": "node scripts/ovsx-publish.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/diff": "^8.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/react-scroll-to-bottom": "^4.2.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode": "1.100.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "3.9.2",
    "acorn": "8.17.0",
    "ovsx": "1.0.2",
    "tailwindcss": "^4.1.4",
    "vite": "^6.3.3",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "4.1.4"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@fontsource-variable/inter": "5.2.8",
    "@moonshot-ai/kimi-code-sdk": "workspace:^",
    "@moonshot-ai/migration-legacy": "workspace:^",
    "@radix-ui/react-accordion": "^1.2.12",
    "@tabler/icons-react": "^3.36.0",
    "ahooks": "^3.9.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^8.0.2",
    "fuse.js": "^7.1.0",
    "heic-to": "^1.0.2",
    "immer": "^11.1.0",
    "katex": "^0.17.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-scroll-to-bottom": "^4.2.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^3.6.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5"
  }
}
